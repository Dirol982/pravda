---
import Base from '../../layouts/Base.astro';
import PriceTable from '../../components/PriceTable.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import {
  categories, getCat, minPrice, catPriceLabel, catNo, hasJeep, absUrl, url, contacts, vibroMin, vibro, type Category,
} from '../../lib/site';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: Category & { h1: string; lead: string; intro: string[]; symptoms: string[]; related: string[]; vibro?: boolean; seasonal?: boolean } };
const min = minPrice(cat);
const title = min !== null
  ? `${cat.name} в Минске — цены от ${min} р. | СТО Правда`
  : `${cat.name} в Минске — цена по запросу | СТО Правда`;
const description = `${cat.lead} ${min !== null ? `Цены на работы от ${min} р.` : 'Цену назовём после диагностики.'} Согласуем до начала ремонта, старые детали отдаём. Минск, ${contacts.address.street}.`;
const related = cat.related.map(getCat).filter(Boolean) as Category[];
const jeep = hasJeep(cat);

const priced = cat.items.filter((i) => typeof i.price === 'number' && i.price > 0);
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${cat.name} в Минске`,
  serviceType: cat.name,
  description: cat.lead,
  url: absUrl(`/uslugi/${cat.slug}/`),
  areaServed: { '@type': 'City', name: 'Минск' },
  provider: { '@id': absUrl('/') + '#org' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: cat.name,
    itemListElement: cat.items.map((i) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: i.name },
      ...(typeof i.price === 'number'
        ? { priceSpecification: { '@type': 'PriceSpecification', priceCurrency: 'BYN', ...(i.from ? { minPrice: i.price } : { price: i.price }) } }
        : {}),
    })),
  },
  ...(priced.length ? { offers: { '@type': 'AggregateOffer', priceCurrency: 'BYN', lowPrice: min, offerCount: priced.length } } : {}),
};
---
<Base title={title} description={description} crumbs={[{ name: 'Услуги', href: '/uslugi/' }, { name: cat.name }]} schema={[serviceLd]}>
  <header class="page-head wrap svc-head">
    <div>
      <p class="label"><b>{catNo(cat)}</b> · {cat.short}{cat.seasonal && ' · сезонная услуга'}</p>
      <h1>{cat.h1} в&nbsp;Минске</h1>
      <p class="lead">{cat.lead}</p>
      <div class="btn-row">
        <a class="btn btn--accent" href="#price">Цены {catPriceLabel(cat)}</a>
        <a class="btn" href={url('/#kviz')}>Рассчитать и записаться<Icon name="arrow" /></a>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap svc-body">
      <div class="prose" data-reveal>
        <p class="label label--plain">О работе</p>
        {cat.intro.map((p) => <p>{p}</p>)}
        {cat.vibro && (
          <p class="svc-vibro">
            <a href={url('/vibrostend/')}>Диагностика подвески на вибростенде</a> — от {vibroMin} р. за ось, {vibro.duration}.
          </p>
        )}
      </div>
      <aside class="svc-sym" data-reveal>
        <p class="label">Когда ехать</p>
        <ul class="list-check">{cat.symptoms.map((s) => <li>{s}</li>)}</ul>
      </aside>
    </div>
  </section>

  <section class="section section--paper" id="price">
    <div class="wrap">
      <div class="sec-head">
        <p class="label"><b>Прайс</b> · {cat.items.length} поз.</p>
        <h2>Цены: {cat.short.toLowerCase()}</h2>
      </div>
      <PriceTable items={cat.items} jeepCols={jeep} />
      <p><a href={url('/ceny/')}>Весь прайс с поиском →</a></p>
    </div>
  </section>

  <Cta />

  {related.length > 0 && (
    <section class="section">
      <div class="wrap">
        <p class="label"><b>Связанные услуги</b></p>
        <ul class="rel">
          {related.map((r) => (
            <li><a href={url(`/uslugi/${r.slug}/`)}><span class="mono">{catNo(r)}</span><b>{r.name}</b><span class="mono">{catPriceLabel(r)}</span><Icon name="arrow" /></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .svc-head .btn-row { margin-top: 24px; }
  .svc-body { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(28px, 5vw, 72px); }
  .svc-vibro { border-left: 3px solid var(--accent); padding-left: 14px; color: var(--ink) !important; font-weight: 600; }
  .svc-sym .label { margin-bottom: 8px; }
  @media (max-width: 860px) { .svc-body { grid-template-columns: 1fr; } }
  .rel { list-style: none; padding: 0; margin: 18px 0 0; border-top: 1px solid var(--line); }
  .rel a { display: grid; grid-template-columns: 40px 1fr auto 24px; gap: 16px; align-items: center; padding: 18px 4px; border-bottom: 1px solid var(--line); text-decoration: none; transition: background-color .2s; }
  .rel a:hover { background: var(--accent); color: var(--accent-ink); }
  .rel b { font: 700 clamp(16px, 2vw, 22px)/1.2 var(--font-head); }
  .rel .mono { font-size: 13px; }
  @media (max-width: 520px) { .rel a { grid-template-columns: 1fr auto; gap: 4px 12px; } .rel a > .mono:first-child, .rel a svg { display: none; } }
</style>
