---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { categories, catPriceLabel, catNo, url, vibroMin } from '../../lib/site';
---
<Base
  title="Услуги автосервиса в Минске — каталог работ | СТО Правда"
  description={`Каталог услуг СТО Правда в Минске: ${categories.length} направлений — от замены масла до ремонта АКПП и кузова. Цены «от» по каждому направлению.`}
  crumbs={[{ name: 'Услуги' }]}
>
  <header class="page-head wrap">
    <p class="label"><b>Услуги</b> · {categories.length} направлений</p>
    <h1>Услуги автосервиса</h1>
    <p class="lead">Выберите направление: на странице — признаки неисправности, прайс и запись.</p>
  </header>
  <section class="wrap cat-list">
    <ol>
      <li><a href={url('/vibrostend/')} class="is-flag"><span class="mono">★</span><span><b>Вибростенд</b><small>Диагностика подвески без разборки</small></span><span class="mono">от {vibroMin} р.</span><Icon name="arrow" /></a></li>
      {categories.map((c) => (
        <li data-season={(c as any).seasonal ? 'winter' : undefined}>
          <a href={url(`/uslugi/${c.slug}/`)}><span class="mono">{catNo(c)}</span><span><b>{c.name}</b><small>{c.lead}</small></span><span class="mono">{catPriceLabel(c)}</span><Icon name="arrow" /></a>
        </li>
      ))}
    </ol>
  </section>
  <div style="height:64px"></div>
  <Cta />
</Base>
<style>
  .cat-list ol { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--line); }
  .cat-list a { display: grid; grid-template-columns: 40px 1fr auto 24px; gap: 16px; align-items: center; padding: 18px 6px; border-bottom: 1px solid var(--line); text-decoration: none; transition: background-color .2s; }
  .cat-list a:hover { background: var(--accent); color: var(--accent-ink); }
  .cat-list b { display: block; font: 700 clamp(17px, 2vw, 22px)/1.2 var(--font-head); }
  .cat-list small { display: block; color: var(--ink-2); font-size: 14px; margin-top: 4px; }
  .cat-list a:hover small { color: var(--accent-ink); }
  .cat-list .mono { font-size: 14px; white-space: nowrap; }
  .cat-list .is-flag { background: var(--ink); color: var(--bg); }
  .cat-list .is-flag small { color: color-mix(in srgb, var(--bg) 70%, transparent); }
  .cat-list .is-season a { box-shadow: inset 4px 0 0 var(--accent); }
  @media (max-width: 600px) { .cat-list a { grid-template-columns: 1fr auto; } .cat-list a > .mono:first-child, .cat-list svg { display: none; } }
</style>
