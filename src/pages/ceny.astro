---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { categories, itemPrice, url, site, vibroPrices, priceText, catNo } from '../lib/site';
const total = categories.reduce((a, c) => a + c.items.length, 0) + vibroPrices.length;
---
<Base
  title="Цены на ремонт авто в Минске — прайс СТО Правда"
  description={`Открытый прайс автосервиса в Минске: ${total} позиций — ТО, подвеска, тормоза, двигатель, выхлоп, кондиционеры. Цены на работы, согласуем до начала ремонта.`}
  crumbs={[{ name: 'Цены' }]}
>
  <header class="page-head wrap">
    <p class="label"><b>Прайс</b> · {total} позиций · BYN</p>
    <h1>Цены на работы</h1>
    <p class="lead">Один прайс для всех направлений. Найдите работу по названию или выберите раздел.</p>
  </header>

  <section class="wrap">
    <form class="pf" role="search" onsubmit="return false">
      <label class="pf__search">
        <span class="sr-only">Поиск по названию работы</span>
        <input type="search" id="pf-q" placeholder="Поиск: колодки, масло, ШРУС…" autocomplete="off" />
      </label>
      <label class="pf__cat">
        <span class="sr-only">Направление</span>
        <select id="pf-cat">
          <option value="">Все направления</option>
          <option value="vibro">Вибростенд</option>
          {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
      </label>
      <div class="pf__toggle" role="radiogroup" aria-label="Тип автомобиля">
        <label><input type="radio" name="pf-body" value="car" checked /><span>Легковой</span></label>
        <label><input type="radio" name="pf-body" value="jeep" /><span>Джип / микроавтобус</span></label>
      </div>
    </form>
    <p class="pf__count mono" aria-live="polite"><span id="pf-n">{total}</span> поз. · <span class="pf__jeep-mark">◆</span> — цена для джипа/микроавтобуса отличается</p>

    <div class="pt-scroll">
      <table class="order" id="pt">
        <thead><tr><th class="c-no" scope="col">№</th><th scope="col">Работа</th><th class="c-price" scope="col">Цена</th></tr></thead>
        <tbody data-cat="vibro">
          <tr class="cat-row"><td colspan="3"><a href={url('/vibrostend/')}>★ Вибростенд</a></td></tr>
          {vibroPrices.map((p, k) => (
            <tr data-name={`вибростенд диагностика подвески ${p.label}`.toLowerCase()} data-only={p.id}>
              <td class="c-no">00.0{k + 1}</td>
              <td>Диагностика подвески на вибростенде <span class="unit">· 1 ось · {p.label.toLowerCase()}</span><span class="muted">2 оси — {priceText(p.twoAxles)}</span></td>
              <td class="c-price">{priceText(p.oneAxle)}</td>
            </tr>
          ))}
        </tbody>
        {categories.map((c) => (
          <tbody data-cat={c.slug}>
            <tr class="cat-row"><td colspan="3"><a href={url(`/uslugi/${c.slug}/`)}>{catNo(c)} · {c.name}</a></td></tr>
            {c.items.map((i) => {
              const diff = i.priceJeep !== undefined && i.priceJeep !== i.price;
              return (
                <tr data-name={i.name.toLowerCase()}>
                  <td class="c-no">{i.id}</td>
                  <td>{i.name}{i.unit && <span class="unit"> · {i.unit}</span>}{diff && <span class="pf__jeep-mark" title="Для джипа/микроавтобуса цена отличается"> ◆</span>}{i.note && !i.note.startsWith('TODO') && <span class="muted">{i.note}</span>}</td>
                  <td class:list={['c-price', { 'is-req': i.price === null }]} data-car={itemPrice(i)} data-jeep={itemPrice(i, true)}>{itemPrice(i)}</td>
                </tr>
              );
            })}
          </tbody>
        ))}
      </table>
    </div>
    <p class="pf__empty" id="pf-empty" hidden>Ничего не нашли. Позвоните — подскажем цену по телефону.</p>
    <p class="note">{site.priceNote}</p>
  </section>
  <div style="height:64px"></div>
  <Cta title="Не нашли свою работу?" text="Позвоните или напишите — назовём ориентир. Точную цену согласуем после диагностики." />
</Base>

<script>
  const q = document.getElementById('pf-q') as HTMLInputElement;
  const cat = document.getElementById('pf-cat') as HTMLSelectElement;
  const bodies = [...document.querySelectorAll<HTMLTableSectionElement>('#pt tbody')];
  const n = document.getElementById('pf-n')!;
  const empty = document.getElementById('pf-empty')!;
  const params = new URLSearchParams(location.search);
  if (params.get('cat')) cat.value = params.get('cat')!;
  if (params.get('q')) q.value = params.get('q')!;

  function body() { return (document.querySelector('input[name="pf-body"]:checked') as HTMLInputElement).value; }
  function apply() {
    // поиск по основам слов: «колодки» найдёт «колодок», «амортизатор» — «амортизаторов»
    const words = q.value.trim().toLowerCase().replace(/ё/g, 'е').split(/\s+/).filter(Boolean).map((w) => w.slice(0, Math.max(5, w.length - 2)));
    const b = body();
    let count = 0;
    bodies.forEach((tb) => {
      let vis = 0;
      const catOk = !cat.value || tb.dataset.cat === cat.value;
      tb.querySelectorAll<HTMLTableRowElement>('tr[data-name]').forEach((tr) => {
        const only = tr.dataset.only;
        const ok = catOk && words.every((w) => tr.dataset.name!.replace(/ё/g, 'е').includes(w)) && (!only || only === b);
        tr.hidden = !ok; if (ok) vis++;
        const pc = tr.querySelector<HTMLElement>('[data-car]');
        if (pc) pc.textContent = b === 'jeep' ? pc.dataset.jeep! : pc.dataset.car!;
      });
      tb.hidden = vis === 0; count += vis;
    });
    n.textContent = String(count);
    empty.hidden = count > 0;
  }
  q.addEventListener('input', apply);
  cat.addEventListener('change', apply);
  document.querySelectorAll('input[name="pf-body"]').forEach((r) => r.addEventListener('change', apply));
  apply();
</script>

<style>
  .pf { display: grid; grid-template-columns: 1fr 280px auto; gap: 10px; margin-bottom: 10px; position: sticky; top: var(--header-h); z-index: 5; background: var(--bg); padding: 10px 0; border-bottom: 1px solid var(--line-soft); }
  .pf input[type='search'], .pf select { width: 100%; height: 52px; border: 1px solid var(--line); background: var(--paper); padding: 0 14px; border-radius: var(--radius); font-size: 16px; }
  .pf__toggle { display: flex; border: 1px solid var(--line); border-radius: var(--radius); }
  .pf__toggle label { position: relative; cursor: pointer; }
  .pf__toggle input { position: absolute; opacity: 0; }
  .pf__toggle span { display: flex; align-items: center; height: 50px; padding: 0 16px; font-weight: 600; white-space: nowrap; }
  .pf__toggle input:checked + span { background: var(--ink); color: var(--bg); }
  .pf__toggle input:focus-visible + span { outline: 3px solid var(--accent); }
  .pf__count { font-size: 12px; color: var(--ink-3); margin: 6px 0 14px; }
  .pf__jeep-mark { color: var(--accent); font-size: 12px; }
  .pf__empty { padding: 24px; border: 1px dashed var(--line); text-align: center; margin-top: 12px; }
  .pt-scroll { overflow-x: auto; }
  @media (max-width: 900px) {
    .pf { grid-template-columns: 1fr 1fr; }
    .pf__search { grid-column: 1 / -1; }
    .pf__toggle span { padding: 0 10px; font-size: 14px; }
    .pf__toggle label { flex: 1; } .pf__toggle span { justify-content: center; }
  }
  @media (max-width: 560px) {
    .pf { grid-template-columns: 1fr; position: static; }
  }
</style>
