---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url, mainPhone, tel } from '../lib/site';
---
<Base title="Страница не найдена | СТО Правда" description="Такой страницы нет. Перейдите на главную, в прайс или позвоните нам." noindex>
  <section class="wrap e404">
    <p class="label">Ошибка 404</p>
    <h1>Такой страницы нет.<br />Это правда.</h1>
    <p class="lead">Возможно, ссылка устарела после переезда сайта. Вот что есть:</p>
    <div class="btn-row">
      <a class="btn btn--accent" href={url('/')}>На главную</a>
      <a class="btn" href={url('/ceny/')}>Цены</a>
      <a class="btn" href={url('/uslugi/')}>Услуги</a>
      <a class="btn" href={tel(mainPhone.number)}><Icon name="phone" />{mainPhone.display}</a>
    </div>
  </section>
</Base>
<style>
  .e404 { padding-block: clamp(64px, 12vw, 160px); }
  .e404 h1 { margin: 16px 0; }
  .e404 .lead { color: var(--ink-2); font-size: 18px; margin-bottom: 24px; }
</style>
