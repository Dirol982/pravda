---
// Шрифты Google Fonts (Unbounded, Manrope, JetBrains Mono) — self-host через @fontsource:
// без стороннего блокирующего CSS, только кириллица + латиница.
import '@fontsource/unbounded/cyrillic-700.css';
import '@fontsource/unbounded/cyrillic-800.css';
import '@fontsource/unbounded/latin-700.css';
import '@fontsource/unbounded/latin-800.css';
import '@fontsource/manrope/cyrillic-400.css';
import '@fontsource/manrope/cyrillic-600.css';
import '@fontsource/manrope/cyrillic-700.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/jetbrains-mono/cyrillic-400.css';
import '@fontsource/jetbrains-mono/cyrillic-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import headFont from '@fontsource/unbounded/files/unbounded-cyrillic-800-normal.woff2?url';
import bodyFont from '@fontsource/manrope/files/manrope-cyrillic-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Crumbs from '../components/Crumbs.astro';
import { url, absUrl, site, contacts, hoursJson, openingHoursSchema } from '../lib/site';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; href?: string }[];
  schema?: object[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, crumbs, schema = [], noindex = false, ogImage = site.ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = absUrl(ogImage);

const business = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': absUrl('/') + '#org',
  name: contacts.name,
  alternateName: 'СТО Правда',
  url: absUrl('/'),
  image: og,
  logo: absUrl('/favicon.svg'),
  telephone: contacts.phones.map((p) => p.number),
  email: contacts.email,
  priceRange: '15–7000 BYN',
  currenciesAccepted: 'BYN',
  paymentAccepted: contacts.payment.join(', '),
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacts.address.street,
    addressLocality: contacts.address.city,
    postalCode: contacts.address.postalCode,
    addressCountry: contacts.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: contacts.geo.lat, longitude: contacts.geo.lon },
  openingHours: openingHoursSchema,
  sameAs: [contacts.social.instagram, contacts.social.vk, contacts.social.youtube, contacts.telegram, contacts.yandex.reviewsUrl],
  legalName: contacts.legal.name,
  taxID: contacts.legal.unp,
};
const breadcrumbs = crumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Главная', href: '/' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: c.href ? absUrl(c.href) : canonical,
  })),
};
const ld = [business, ...(breadcrumbs ? [breadcrumbs] : []), ...schema];
const metrikaId = site.metrika.id;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#15140f" media="(prefers-color-scheme: dark)" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={site.siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href={headFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {metrikaId && (
    <script is:inline define:vars={{ metrikaId }}>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
      ym(Number(metrikaId),'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true});
    </script>
  )}
</head>
<body>
  <a class="skip" href="#main">К содержимому</a>
  <Header />
  <main id="main">
    {crumbs && <Crumbs items={crumbs} />}
    <slot />
  </main>
  <Footer />
  <MobileBar />
  {metrikaId && (
    <div class="cookie" hidden>
      <p>Сайт использует cookie и Яндекс.Метрику для статистики посещений. <a href={url('/cookie/')}>Подробнее</a></p>
      <button class="btn btn--sm btn--accent" type="button">Понятно</button>
    </div>
  )}
  <script is:inline define:vars={{ hoursJson }}>
    // Живой статус «Открыто до … / Закрыто, откроемся …» по часам из contacts.json (Europe/Minsk)
    (function () {
      var H = JSON.parse(hoursJson), D = ['sun','mon','tue','wed','thu','fri','sat'];
      var RU = { mon:'в пн', tue:'во вт', wed:'в ср', thu:'в чт', fri:'в пт', sat:'в сб', sun:'в вс' };
      function now() {
        var p = new Intl.DateTimeFormat('en-GB', { timeZone: H.tz, weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
        var o = {}; p.forEach(function (x) { o[x.type] = x.value; });
        var wd = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].indexOf(o.weekday);
        return { d: wd, m: (+o.hour % 24) * 60 + +o.minute };
      }
      function mins(s) { var a = s.split(':'); return +a[0] * 60 + +a[1]; }
      function hm(s) { return s.replace(/^0/, ''); }
      function calc() {
        var n = now(), t = H.week[D[n.d]];
        if (t && n.m >= mins(t[0]) && n.m < mins(t[1])) return { open: 1, text: 'Открыто до ' + hm(t[1]) };
        if (t && n.m < mins(t[0])) return { open: 0, text: 'Закрыто, откроемся в ' + hm(t[0]) };
        for (var i = 1; i <= 7; i++) {
          var k = D[(n.d + i) % 7], s = H.week[k];
          if (s) return { open: 0, text: 'Закрыто, откроемся ' + (i === 1 ? 'завтра' : RU[k]) + ' в ' + hm(s[0]) };
        }
        return { open: 0, text: 'Закрыто' };
      }
      function paint() {
        var r = calc();
        document.querySelectorAll('[data-status]').forEach(function (el) { el.textContent = r.text; el.setAttribute('data-open', r.open); });
      }
      paint(); setInterval(paint, 60000);

      // Появление блоков при скролле
      var els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      } else els.forEach(function (el) { el.classList.add('is-in'); });

      // Сезонные плитки (свечи накала — ноябрь…март)
      var mo = new Date().getMonth() + 1;
      if (mo >= 11 || mo <= 3) document.querySelectorAll('[data-season="winter"]').forEach(function (el) { el.classList.add('is-season'); });

      // Баннер cookie (только если подключена Метрика)
      var c = document.querySelector('.cookie');
      if (c) {
        var ok; try { ok = localStorage.getItem('cookie-ok'); } catch (e) {}
        if (!ok) { c.hidden = false; c.querySelector('button').onclick = function () { try { localStorage.setItem('cookie-ok', '1'); } catch (e) {} c.hidden = true; }; }
      }
    })();
  </script>
  <style is:global>
    .cookie { position: fixed; z-index: 70; left: 12px; right: 12px; bottom: calc(var(--bar-h) + 12px); max-width: 520px; display: flex; gap: 12px; align-items: center; background: var(--paper); border: 1px solid var(--line); padding: 12px 14px; font-size: 14px; }
    .cookie p { margin: 0; }
    @media (min-width: 961px) { .cookie { bottom: 16px; } }
  </style>
</body>
</html>
