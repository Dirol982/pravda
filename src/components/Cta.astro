---
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { url, mainPhone, tel, viberChat, contacts } from '../lib/site';
interface Props { title?: string; text?: string }
const { title = 'Расскажите, что с машиной', text = 'Назовём ориентир по цене по телефону. Точную стоимость — после диагностики, и согласуем её до начала работ.' } = Astro.props;
---
<section class="cta">
  <div class="wrap cta__in" data-reveal>
    <div>
      <p class="label label--plain"><OpenStatus /></p>
      <h2>{title}</h2>
      <p class="cta__text">{text}</p>
    </div>
    <div class="cta__btns">
      <a class="btn btn--accent" href={tel(mainPhone.number)}><Icon name="phone" />{mainPhone.display}</a>
      <a class="btn" href={viberChat()}><Icon name="viber" />Viber</a>
      <a class="btn" href={contacts.telegram} target="_blank" rel="noopener"><Icon name="telegram" />Telegram</a>
      <a class="btn" href={url('/#kviz')}>Рассчитать стоимость<Icon name="arrow" /></a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--ink); color: var(--bg); padding-block: clamp(48px, 7vw, 88px); }
  .cta__in { display: grid; gap: 28px; grid-template-columns: 1.2fr 1fr; align-items: end; }
  .cta h2 { color: var(--bg); margin: 12px 0 12px; }
  .cta__text { color: color-mix(in srgb, var(--bg) 75%, transparent); max-width: 52ch; margin: 0; }
  .cta .btn { color: var(--bg); --b: var(--bg); border-color: var(--bg); }
  .cta .btn:hover { background: var(--bg); color: var(--ink); }
  .cta .btn--accent { color: var(--accent-ink); border-color: var(--accent); }
  .cta__btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .cta__btns .btn:first-child { grid-column: 1 / -1; }
  @media (max-width: 860px) { .cta__in { grid-template-columns: 1fr; } }
  @media (max-width: 400px) { .cta__btns { grid-template-columns: 1fr; } }
</style>
