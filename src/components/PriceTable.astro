---
import { itemPrice, type PriceItem, site } from '../lib/site';
interface Props { items: PriceItem[]; jeepCols?: boolean; caption?: string; note?: boolean }
const { items, jeepCols = false, caption, note = true } = Astro.props;
---
<div class="pt-scroll">
<table class:list={['order', { 'order--jeep': jeepCols }]}>
  {caption && <caption class="label">{caption}</caption>}
  <thead>
    <tr>
      <th class="c-no" scope="col">№</th>
      <th scope="col">Работа</th>
      {jeepCols ? (<><th class="c-price" scope="col">Легковой</th><th class="c-price" scope="col">Джип / микроавт.</th></>) : <th class="c-price" scope="col">Цена</th>}
    </tr>
  </thead>
  <tbody>
    {items.map((i) => (
      <tr>
        <td class="c-no">{i.id}</td>
        <td>{i.name}{i.unit && <span class="unit"> · {i.unit}</span>}{i.note && !i.note.startsWith('TODO') && <span class="muted">{i.note}</span>}</td>
        <td class:list={['c-price', { 'is-req': i.price === null }]}>{itemPrice(i)}</td>
        {jeepCols && <td class:list={['c-price', { 'is-req': i.price === null }]}>{i.priceJeep !== undefined ? itemPrice(i, true) : itemPrice(i)}</td>}
      </tr>
    ))}
  </tbody>
</table>
</div>
{note && <p class="note">{site.priceNote}</p>}
<style>
  .pt-scroll { overflow-x: auto; }
  @media (max-width: 600px) {
    .order--jeep .c-no { display: none; }
    .order--jeep th.c-price { white-space: normal; }
    .order--jeep .c-price { font-size: 13px; }
  }
</style>
