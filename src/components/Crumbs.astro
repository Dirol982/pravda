---
import { url } from '../lib/site';
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Хлебные крошки">
  <ol>
    <li><a href={url('/')}>Главная</a></li>
    {items.map((i) => <li>{i.href ? <a href={url(i.href)}>{i.name}</a> : <span aria-current="page">{i.name}</span>}</li>)}
  </ol>
</nav>
