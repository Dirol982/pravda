---
import Icon from './Icon.astro';
import { contacts, mainPhone, tel, viberChat, routeUrl } from '../lib/site';
---
<nav class="mbar" aria-label="Быстрая связь">
  <a href={tel(mainPhone.number)} class="mbar__main"><Icon name="phone" /><span>Позвонить</span></a>
  <a href={viberChat()}><Icon name="viber" /><span>Viber</span></a>
  <a href={contacts.telegram} target="_blank" rel="noopener"><Icon name="telegram" /><span>Telegram</span></a>
  <a href={routeUrl} target="_blank" rel="noopener"><Icon name="route" /><span>Маршрут</span></a>
</nav>
<style>
  .mbar { position: fixed; z-index: 60; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; background: var(--paper); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom); }
  .mbar a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; height: var(--bar-h); text-decoration: none; font: 600 12px/1 var(--font-body); border-left: 1px solid var(--line-soft); }
  .mbar a:first-child { border-left: 0; }
  .mbar__main { background: var(--accent); color: var(--accent-ink); }
  @media (min-width: 961px) { .mbar { display: none; } }
</style>
