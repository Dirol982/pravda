---
// Карта-«фасад»: iframe Яндекс.Карт грузится по клику — без сторонних cookie и лишнего JS при загрузке.
import Icon from './Icon.astro';
import { contacts, mapEmbed, routeUrl } from '../lib/site';
interface Props { class?: string }
---
<div class:list={['ymap', Astro.props.class]} data-ymap={mapEmbed}>
  <div class="ymap__face">
    <span class="ymap__pin"><Icon name="route" /></span>
    <p class="ymap__addr">{contacts.address.full}</p>
    <p class="ymap__coords mono">{contacts.geo.lat.toFixed(5)}° N · {contacts.geo.lon.toFixed(5)}° E</p>
    <div class="btn-row">
      <button type="button" class="btn btn--accent" data-ymap-load>Показать карту</button>
      <a class="btn" href={routeUrl} target="_blank" rel="noopener">Маршрут<Icon name="arrow" /></a>
    </div>
    <p class="ymap__hint">Карта загружается с Яндекса после нажатия.</p>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-ymap]').forEach((box) => {
    box.querySelector('[data-ymap-load]')?.addEventListener('click', () => {
      box.innerHTML = `<iframe src="${box.dataset.ymap}" title="СТО Правда на Яндекс.Картах" allowfullscreen></iframe>`;
    });
  });
</script>
<style>
  .ymap { position: relative; border: 1px solid var(--line); min-height: 380px; height: 100%;
    background: linear-gradient(var(--line-soft) 1px, transparent 1px) 0 0 / 40px 40px, linear-gradient(90deg, var(--line-soft) 1px, transparent 1px) 0 0 / 40px 40px, var(--bg-2); }
  .ymap :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ymap__face { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px; }
  .ymap__pin { width: 56px; height: 56px; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); border: 2px solid var(--ink); margin-bottom: 14px; }
  .ymap__pin :global(svg) { width: 28px; height: 28px; }
  .ymap__addr { font: 700 clamp(17px, 2vw, 22px)/1.2 var(--font-head); margin: 0 0 6px; background: var(--paper); padding: 4px 8px; }
  .ymap__coords { font-size: 12px; color: var(--ink-3); margin-bottom: 18px; background: var(--paper); padding: 2px 6px; }
  .ymap .btn-row { justify-content: center; }
  .ymap__hint { font-size: 12px; color: var(--ink-3); margin: 12px 0 0; background: var(--paper); padding: 2px 6px; }
</style>
